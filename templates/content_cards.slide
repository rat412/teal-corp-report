<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0 }}>
    <Image src="assets/logo.png" style={{ position: 'absolute', left: 42, top: 20, width: 90, height: 31 }} />
    <Text style={{ position: 'absolute', left: 145, top: 22, width: 1080, fontSize: 34, fontWeight: 'bold', color: '#00918D', fontFamily: '微软雅黑' }}>{{页面标题}}</Text>
    <Box style={{ position: 'absolute', left: 42, top: 76, width: 1196, border: '1.5px solid #BFE0DA', borderRadius: 10, padding: '14px 24px', background: '#FFFFFF' }}>
        <Text style={{ fontSize: 19, color: '#1E293B', lineHeight: 1.55, fontFamily: '微软雅黑' }}>　　{{正文段落}}</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 42, top: {{卡片区top}}, width: 1196, flexDirection: 'row', gap: 24 }}>
        {[
            { t: '{{卡片1标题}}', d: '{{卡片1正文}}' },
            { t: '{{卡片2标题}}', d: '{{卡片2正文}}' },
            { t: '{{卡片3标题}}', d: '{{卡片3正文}}' },
        ].map((c, i) => (
            <Box key={i} style={{ flex: 1, background: '#E9F4F0', borderRadius: 12, padding: 24 }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#00918D', fontFamily: '微软雅黑' }}>{c.t}</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', fontFamily: '微软雅黑', lineHeight: 1.65, marginTop: 12 }}>{c.d}</Text>
            </Box>
        ))}
    </Box>
    <Text style={{ position: 'absolute', right: 56, top: 678, fontSize: 14, color: '#707070', fontFamily: 'Arial' }}>{{页码}}</Text>
</Slide>
